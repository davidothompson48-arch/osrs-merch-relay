{
  "schema_version": 2,
  "updated_at_utc": "2026-08-29T07:00:00Z",
  "objective": "Maximize long-run expected GP growth, not headline ROI. Prefer high probability-weighted GP per unit time, scalable capacity, reliable execution, low player-time cost and low correlation.",
  "primary_ranking_metrics": [
    "expected_gp_per_hour",
    "expected_profit_at_capacity_gp",
    "expected_after_tax_roi_pct",
    "capacity_gp",
    "execution_probability",
    "player_time_adjusted_profit_gp",
    "slot_efficiency_gp_per_hour"
  ],
  "capacity_model": {
    "participation_fraction_of_1h_volume_by_liquidity": {
      "VERY LIQUID": 0.10,
      "LIQUID": 0.08,
      "MODERATE": 0.06,
      "THIN": 0.03,
      "VERY THIN": 0.01,
      "UNKNOWN": 0.03
    },
    "evergreen_fraction_of_24h_volume": 0.015,
    "conversion_output_fraction_of_24h_volume": 0.03,
    "hard_max_fraction_of_1h_volume": 0.15,
    "slippage_labels": {
      "LOW_max_participation_pct": 5,
      "MEDIUM_max_participation_pct": 10,
      "HIGH_above_participation_pct": 10
    },
    "rule": "Capacity is a conservative model of how much can be deployed without assuming the visible one-unit edge scales indefinitely. It is not a guaranteed fill size."
  },
  "execution_model": {
    "freshness_factor": {"FRESH": 1.0, "USABLE": 0.85, "STALEISH": 0.55, "STALE": 0.20, "INCOMPLETE": 0.45},
    "fast_flip_base_hold_hours": 2.0,
    "fast_flip_curve_anchor_hours": 2.0,
    "fast_flip_max_modeled_cycle_hours": 24.0,
    "fast_flip_horizons_minutes": [5, 15, 60, 120, 240],
    "evergreen_base_hold_hours": 72.0,
    "conversion_base_exit_hours": 4.0,
    "minimum_modeled_execution_probability": 0.12,
    "rule": "Execution probabilities are ranking heuristics based on observed flow/freshness and are never presented as guaranteed fill odds. Fast flips expose separate entry, exit and round-trip cumulative probability curves instead of a single undifferentiated execution number."
  },
  "real_execution_learning": {
    "enabled": true,
    "horizons_minutes": [5, 15, 60, 120, 240],
    "item_min_samples_before_blend": 8,
    "engine_min_samples_before_blend": 20,
    "prior_strength_samples": 12,
    "maximum_empirical_weight": 0.75,
    "rule": "User-confirmed GE orders are the highest-quality execution evidence. Empirical fill curves may blend into model probabilities only after minimum sample thresholds; unknown timestamps never become negative samples."
  },
  "spread_persistence": {
    "enabled": true,
    "lookback_minutes": 120,
    "state_retention_hours": 6,
    "maximum_observations_per_item": 30,
    "maximum_snapshot_gap_seconds": 720,
    "minimum_snapshots_persistent": 3,
    "minimum_minutes_persistent": 10,
    "minimum_qualified_ratio_persistent": 0.67,
    "minimum_snapshots_repeatable": 6,
    "minimum_minutes_repeatable": 30,
    "minimum_qualified_ratio_repeatable": 0.75,
    "max_high_low_age_seconds": 900,
    "minimum_one_hour_volume": 20,
    "minimum_each_side_share": 0.05,
    "minimum_roi_retention_vs_median": 0.45,
    "execution_multiplier": {
      "REPEATABLE_MARKET": 1.05,
      "PERSISTENT_SPREAD": 1.0,
      "FLASH_SPREAD": 0.55,
      "UNSTABLE_SPREAD": 0.35,
      "INVALID_SPREAD": 0.10,
      "UNKNOWN": 0.50
    },
    "auto_allocation_eligible_classes": ["PERSISTENT_SPREAD", "REPEATABLE_MARKET"],
    "rule": "A fast flip is not automatic-allocation eligible until its spread survives at least three consecutive snapshots and ten minutes with fresh HIGH/LOW prints, both sides trading, adequate turnover and retained positive after-tax edge."
  },
  "player_time": {
    "shadow_value_gp_per_hour": 2500000,
    "attention_factors": {
      "HIGH": 1.0,
      "MEDIUM": 0.6,
      "LOW": 0.3,
      "NEGLIGIBLE": 0.1,
      "PASSIVE": 0.0
    },
    "default_manual_attention": "MEDIUM",
    "rule": "Manual processing is charged against an explicit configurable shadow value of player time. Show raw profit and player-time-adjusted profit separately."
  },
  "ge_slots": {
    "total_slots": 8,
    "minimum_slot_efficiency_gp_per_hour": 50000,
    "known_open_offers_consume_slots": true,
    "rule": "Rank slot use by expected GP/hour after execution/player-time adjustment. Unknown non-desk GE orders mean free-slot counts are upper bounds, not facts."
  },
  "capital_aging": {
    "enabled": true,
    "penalty_begins_at_expected_payoff_multiple": 1.0,
    "score_penalty_per_half_life_overdue": 4,
    "maximum_score_penalty": 20,
    "reset_only_on": ["new confirmed catalyst", "materially improved expected value", "explicit strategy re-underwrite"],
    "rule": "Dead capital becomes progressively less competitive even if the original thesis has not fully invalidated. Hold-for-use gear is exempt."
  },
  "shadow_learning": {
    "checkpoints_hours": [1, 4, 24, 72, 168],
    "minimum_samples_before_score_adjustment": 20,
    "maximum_learning_adjustment_points": 8,
    "signal_cooldown_hours": {"fast_flip": 8, "momentum": 12, "evergreen": 24, "conversion": 12},
    "rule": "Shadow signals are research observations, not claimed executions. Real user-confirmed fills remain the higher-quality evidence source."
  },
  "regime_model": {
    "minimum_liquid_item_gp_per_hour": 20000000,
    "risk_on_breadth_pct": 62,
    "risk_off_breadth_pct": 62,
    "median_move_threshold_pct": 0.75,
    "labels": ["BROAD_RISK_ON", "MIXED", "BROAD_RISK_OFF", "HIGH_DISPERSION"]
  },
  "value_graph": {
    "prefer_mechanical_edges": true,
    "include_processing": true,
    "include_npc_exchange": true,
    "include_dose_decanting": true,
    "include_sets_components": true,
    "rule": "Mechanical edges compete directly against speculative trades after tax, capacity, labor and liquidity."
  },
  "future_engine_hooks": {
    "order_price_optimizer": {"status": "PLANNED", "phase": 2, "depends_on": ["real_execution_learning", "multi_horizon_fill_curves"]},
    "gp_per_slot_hour_optimizer": {"status": "PLANNED", "phase": 2, "depends_on": ["real_execution_learning"]},
    "active_vs_parking_slot_buckets": {"status": "PLANNED", "phase": 2},
    "minimum_absolute_profit_hurdles": {"status": "PLANNED", "phase": 3},
    "repeatability_multiplier": {"status": "PLANNED", "phase": 3, "depends_on": ["spread_persistence", "real_execution_learning"]},
    "opportunity_book": {"status": "PLANNED", "phase": 3, "depends_on": ["spread_persistence"]},
    "attention_modes": {"status": "PLANNED", "phase": 4},
